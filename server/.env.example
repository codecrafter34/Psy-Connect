# ==========================================
# AWS REKOGNITION SETUP
# ==========================================

# 1. Open AWS Console:
#    https://console.aws.amazon.com/

# 2. Do NOT create an access key for the AWS root user.
#
# 3. Open IAM:
#    https://console.aws.amazon.com/iam/
#
# 4. Create a dedicated IAM user for this application.
#
# Suggested username:
#    psy-connect-rekognition
#
# 5. Give this user ONLY the permission required for this app:
#
#    rekognition:DetectFaces
#
# Prefer a least-privilege custom IAM policy instead of broad
# administrator permissions.

# 6. Open the IAM user's:
#    Security credentials
#
# 7. Create an access key.
#
# 8. AWS will show:
#    Access key ID
#    Secret access key
#
# IMPORTANT:
# The secret access key is shown only when the key is created.
# Save it securely.

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Safety limits
AWS_MONTHLY_ANALYSIS_LIMIT=800
AWS_DAILY_ANALYSIS_LIMIT_PER_USER=20

# ==========================================
# EXISTING APP CONFIGURATION
# ==========================================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_change_me_in_production
CLIENT_URL=http://localhost:8080
PORT=5000
NODE_ENV=development
